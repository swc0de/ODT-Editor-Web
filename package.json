{
  "name": "odt-editor",
  "version": "1.0.0",
  "private": true,
  "description": "A full offline word processor for OpenDocument Text, delivered as one self-contained HTML file.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "fixtures": "node tests/make-fixtures.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:e2e": "playwright test --trace off",
    "screenshots": "node tests/screenshots.mjs"
  },
  "dependencies": {
    "docx": "^9.1.1",
    "fflate": "^0.8.3",
    "lucide": "^1.75.0",
    "mammoth": "^1.8.0",
    "marked": "^15.0.6",
    "prosemirror-collab": "^1.3.1",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.4",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.6.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.13",
    "prosemirror-schema-list": "^1.6.0",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.6",
    "prosemirror-view": "^1.42.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "axe-core": "^4.10.2",
    "citeproc": "^2.4.63",
    "dictionary-en": "^4.0.0",
    "dictionary-en-gb": "^3.0.0",
    "esbuild": "^0.28.2",
    "hyphen": "^1.10.6",
    "mathlive": "0.111.4",
    "nspell": "^2.1.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
